<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/updater_screen_background"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/updater_top_bar"
        android:fitsSystemWindows="true"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/updater_top_bar"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
            app:titleTextColor="@color/updater_toolbar_content" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="28dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="30dp"
                app:cardElevation="1dp"
                app:cardUseCompatPadding="false">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/updater_hero_background">

                    <!-- subtle background shapes from the XPerience visual language -->
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/updater_hero_pattern" />

                    <!-- dedicated XPerience mark: no more giant text-X watermark -->
                    <ImageView
                        android:layout_width="128dp"
                        android:layout_height="144dp"
                        android:layout_gravity="end|top"
                        android:layout_marginTop="42dp"
                        android:layout_marginEnd="12dp"
                        android:alpha="0.92"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_xperience_mark" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="22dp"
                        android:paddingTop="18dp"
                        android:paddingEnd="22dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.22"
                            android:text="X P E R I E N C E"
                            android:textAllCaps="true"
                            android:textColor="@color/updater_hero_accent"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:letterSpacing="0.16"
                            android:text="MORE THAN A ROM"
                            android:textColor="@color/updater_hero_on_surface_variant"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/rom_version"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:paddingEnd="108dp"
                            android:textColor="@color/updater_hero_on_surface"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            tools:text="XPerience 21" />

                        <TextView
                            android:id="@+id/system_info"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingEnd="108dp"
                            android:textColor="@color/updater_hero_on_surface_variant"
                            tools:text="Android 17"
                            android:textSize="18sp" />

                        <LinearLayout
                            android:id="@+id/update_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/update_title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:text="@string/update_available"
                                android:textColor="@color/updater_hero_on_surface"
                                android:textSize="21sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/update_date"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                tools:text="11 sep 2026"
                                android:textColor="@color/updater_hero_on_surface_variant"
                                android:textSize="14sp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/update_version"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="10dp"
                                    android:background="@drawable/updater_chip_background"
                                    android:paddingStart="14dp"
                                    android:paddingTop="8dp"
                                    android:paddingEnd="14dp"
                                    android:paddingBottom="8dp"
                                    tools:text="21.0.0"
                                    android:textColor="@color/updater_hero_chip_text"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/update_size"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/updater_chip_background"
                                    android:paddingStart="14dp"
                                    android:paddingTop="8dp"
                                    android:paddingEnd="14dp"
                                    android:paddingBottom="8dp"
                                    tools:text="4.2 GB"
                                    android:textColor="@color/updater_hero_chip_text"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/device_codename"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:background="@drawable/updater_chip_background"
                                    android:paddingStart="14dp"
                                    android:paddingTop="8dp"
                                    android:paddingEnd="14dp"
                                    android:paddingBottom="8dp"
                                    android:textColor="@color/updater_hero_chip_text"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    tools:text="rodin" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/incremental_info"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:textColor="@color/updater_hero_accent_secondary"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:visibility="gone"
                                tools:text="⚡ Incremental · ahorras 4.1 GB"
                                tools:visibility="visible" />

                            <ProgressBar
                                android:id="@+id/download_progress"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="6dp"
                                android:layout_marginTop="18dp"
                                android:layout_marginBottom="10dp"
                                android:indeterminateTint="@color/updater_hero_accent"
                                android:progressBackgroundTint="@color/updater_hero_progress_track"
                                android:progressTint="@color/updater_hero_accent"
                                android:visibility="gone" />

                            <RelativeLayout
                                android:id="@+id/download_info_container"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="14dp"
                                android:visibility="gone">

                                <TextView
                                    android:id="@+id/download_speed"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentStart="true"
                                    android:layout_toStartOf="@id/download_percentage"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    tools:text="16.8 MB/s · Quedan 4 minutos"
                                    android:textColor="@color/updater_hero_on_surface_variant"
                                    android:textSize="13sp" />

                                <TextView
                                    android:id="@+id/download_percentage"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:layout_marginStart="12dp"
                                    tools:text="4%"
                                    android:textColor="@color/updater_hero_on_surface"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />
                            </RelativeLayout>

                            <!-- Reserved breathing room for states without progress/info,
                                 e.g. VERIFIED -> INSTALL. Toggled from UpdatesActivity. -->
                            <View
                                android:id="@+id/update_action_spacer"
                                android:layout_width="match_parent"
                                android:layout_height="22dp"
                                android:visibility="gone" />

                            <LinearLayout
                                android:id="@+id/update_action_row"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <Button
                                    android:id="@+id/download_button"
                                    android:layout_width="0dp"
                                    android:layout_height="56dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/button_background"
                                    android:fontFamily="sans-serif-medium"
                                    android:minWidth="0dp"
                                    android:text="@string/download"
                                    android:textAllCaps="true"
                                    android:textColor="@android:color/white"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <Button
                                    android:id="@+id/cancel_button"
                                    android:layout_width="0dp"
                                    android:layout_height="56dp"
                                    android:layout_marginStart="10dp"
                                    android:layout_weight="0.52"
                                    android:background="@drawable/button_cancel_background"
                                    android:fontFamily="sans-serif-medium"
                                    android:minWidth="0dp"
                                    android:paddingStart="10dp"
                                    android:paddingEnd="10dp"
                                    android:text="@android:string/cancel"
                                    android:textAllCaps="true"
                                    android:textColor="@android:color/white"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:visibility="gone" />
                            </LinearLayout>

                            <!-- Match the upper breathing room for install/retry/reboot states. -->
                            <View
                                android:id="@+id/update_action_bottom_spacer"
                                android:layout_width="match_parent"
                                android:layout_height="18dp"
                                android:visibility="gone" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:lineSpacingExtra="2dp"
                                android:text="@string/download_warning"
                                android:textColor="@color/updater_hero_on_surface_variant"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/updater_surface_card_background"
                    android:gravity="center_vertical"
                    android:minHeight="58dp"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="8dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/updater_support_icon_background"
                        android:padding="8dp"
                        android:src="@drawable/ic_time"
                        android:tint="@color/updater_hero_accent" />

                    <TextView
                        android:id="@+id/last_check"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:lineSpacingExtra="1dp"
                        android:maxLines="2"
                        android:text="@string/last_checked_never"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="13sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:id="@+id/changelog_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/changelog"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/changelog_view_all"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingStart="10dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="6dp"
                        android:text="@string/changelog_view_all"
                        android:textColor="@color/updater_hero_accent"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp">

                    <mx.xperience.updater.widget.MaxHeightNestedScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/updater_surface_card_background"
                        android:clipToPadding="false"
                        android:fadeScrollbars="false"
                        android:overScrollMode="ifContentScrolls"
                        android:scrollbars="vertical"
                        app:maxHeight="360dp">

                        <TextView
                            android:id="@+id/changelog_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:lineSpacingExtra="5dp"
                            android:paddingStart="22dp"
                            android:paddingTop="20dp"
                            android:paddingEnd="22dp"
                            android:paddingBottom="22dp"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="14sp" />
                    </mx.xperience.updater.widget.MaxHeightNestedScrollView>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/update_status_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:visibility="gone"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/updater_surface_card_background"
                    android:gravity="center_vertical"
                    android:minHeight="72dp"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp">

                    <ImageView
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/updater_support_icon_background"
                        android:padding="10dp"
                        android:src="@drawable/ic_system_ready" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/update_status_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/update_status_ready_title"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/update_status_subtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/update_status_ready_subtitle"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:id="@+id/no_new_updates_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/updater_surface_card_background"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingTop="32dp"
                android:paddingEnd="28dp"
                android:paddingBottom="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginBottom="20dp"
                    android:src="@drawable/ic_no_updates"
                    android:tint="@color/updater_hero_accent" />

                <TextView
                    android:id="@+id/no_updates_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/no_updates_available"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/no_updates_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="22dp"
                    android:gravity="center"
                    android:text="@string/no_updates_message"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/check_for_updates_button"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:background="@drawable/button_background"
                    android:minWidth="0dp"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:text="@string/check_for_updates"
                    android:textColor="@android:color/white"
                    android:textSize="14sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/refresh_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="24dp"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>


</androidx.coordinatorlayout.widget.CoordinatorLayout>
