<resources>
    <!-- Tema base basado en AppCompat -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Color primario -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>

        <!-- Colores dinámicos que cambian con el tema -->
        <item name="android:windowBackground">@color/updater_screen_background</item>
        <item name="android:statusBarColor">@color/updater_top_bar</item>
        <item name="android:navigationBarColor">@color/updater_screen_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">@bool/updater_light_navigation_bar</item>

        <!-- Colores para modo claro/oscuro -->
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorOnSurface">@color/on_surface_light</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppTheme.PopupMenuOverlapAnchor">
        <item name="android:overlapAnchor">true</item>
        <item name="android:dropDownVerticalOffset">8dp</item>
        <item name="android:dropDownHorizontalOffset">-16dp</item>
    </style>

    <style name="AppTheme.AlertDialogTheme" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <!-- Tema base -->
    <style name="Theme.Updater" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/material_dynamic_primary40</item>
        <item name="colorPrimaryContainer">@color/material_dynamic_primary90</item>
        <item name="colorSecondary">@color/material_dynamic_secondary40</item>
        <item name="colorSecondaryContainer">@color/material_dynamic_secondary90</item>
        <item name="colorSurface">@color/material_dynamic_neutral95</item>
        <item name="colorSurfaceVariant">@color/material_dynamic_neutral_variant90</item>
        <item name="colorOnSurface">@color/material_dynamic_neutral10</item>
        <item name="android:windowBackground">@color/material_dynamic_neutral95</item>
    </style>

    <!-- Si Material3 no está disponible, usar MaterialComponents como fallback -->
    <style name="Widget.Material3.Toolbar" parent="Widget.AppCompat.Toolbar">
        <!-- Propiedades de Material 3 para Toolbar -->
    </style>

    <style name="Widget.Material3.Button" parent="Widget.AppCompat.Button">
        <!-- Propiedades de Material 3 para Button -->
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
    </style>

    <style name="Widget.Material3.ExtendedFloatingActionButton"
           parent="Widget.Design.FloatingActionButton">
        <!-- Propiedades para FAB extendido -->
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="tint">?attr/colorOnPrimary</item>
    </style>

</resources>
